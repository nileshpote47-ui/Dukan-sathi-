# Copy to .env.local and fill in. Values are in the Supabase dashboard:
# Project Settings -> API (Data API) and API Keys.

# Public (safe in the browser; row level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public base URL of the app, used in email confirmation links.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI content engine (Phase 3) — SERVER-ONLY. Never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# gemini = Google Gemini (production) | mock = deterministic test provider
# (mock is refused on the Vercel production deployment). Unset = AI disabled.
AI_PROVIDER=gemini
# Optional. Default: gemini-3.5-flash
AI_MODEL=
# Secret from https://aistudio.google.com/apikey — keep it out of git and logs.
GEMINI_API_KEY=

# Tests only (AI_PROVIDER=mock): fake latency in ms, or force a failure for every request
# (fail | timeout | rate-limit | malformed | empty | blocked).
# AI_MOCK_DELAY_MS=400
# AI_MOCK_SCENARIO=

# ---------------------------------------------------------------------------
# Media engine (Phase 4) — SERVER-ONLY. AI pictures reuse GEMINI_API_KEY.
# ---------------------------------------------------------------------------
# gemini = Gemini image model | mock = test provider (refused in production).
# Unset = AI pictures off; posters (templates + uploaded photos) and storyboards still work.
MEDIA_PROVIDER=
# Optional. Default: gemini-3.1-flash-image
MEDIA_MODEL=
# Tests only (MEDIA_PROVIDER=mock): force a failure for every picture
# (fail | timeout | rate-limit | blocked | malformed | empty). AI_MOCK_DELAY_MS also applies.
# MEDIA_MOCK_SCENARIO=

# Never add a Supabase secret/service-role key with a NEXT_PUBLIC_ prefix.

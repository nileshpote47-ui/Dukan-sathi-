# Copy to .env.local and fill in. Values are in the Supabase dashboard:
# Project Settings -> API (Data API) and API Keys.

# Public (safe in the browser; row level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public base URL of the app, used in email confirmation links.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI content engine (Phase 3) — SERVER-ONLY. Never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# gemini = Google Gemini (production) | mock = deterministic test provider
# (mock is refused on the Vercel production deployment). Unset = AI disabled.
AI_PROVIDER=gemini
# Optional. Default: gemini-3.5-flash-lite
AI_MODEL=
# Secret from https://aistudio.google.com/apikey — keep it out of git and logs.
GEMINI_API_KEY=

# Tests only (AI_PROVIDER=mock): fake latency in ms, or force a failure for every request
# (fail | timeout | rate-limit | malformed | empty | blocked).
# AI_MOCK_DELAY_MS=400
# AI_MOCK_SCENARIO=

# ---------------------------------------------------------------------------
# Media engine (Phase 4) — SERVER-ONLY. AI pictures reuse GEMINI_API_KEY.
# ---------------------------------------------------------------------------
# gemini = Gemini image model | mock = test provider (refused in production).
# Unset = AI pictures off; posters (templates + uploaded photos) and storyboards still work.
MEDIA_PROVIDER=
# Optional. Default: gemini-3.1-flash-image
MEDIA_MODEL=

# Direct posters (Phase 9): AI designs the whole poster with the owner's own text (server-only).
# Provider defaults to openai when OPENAI_API_KEY is set; tests use DIRECT_POSTER_PROVIDER=mock.
OPENAI_API_KEY=
DIRECT_POSTER_PROVIDER=
DIRECT_POSTER_MODEL=

# --- Reel voiceover (Phase 9 Stage 3b, server-only) ---
# Sarvam AI (Bulbul, Indian languages). Provider defaults to sarvam when SARVAM_API_KEY is set;
# tests use VOICE_PROVIDER=mock (refused in production). Never use a NEXT_PUBLIC_ name for the key.
SARVAM_API_KEY=
VOICE_PROVIDER=
VOICE_MODEL=

# --- Free stock photos (Phase 9 Stage 3b, server-only) ---
# Pixabay API key (free). Provider defaults to pixabay when the key is set; tests use STOCK_PROVIDER=mock.
PIXABAY_API_KEY=
STOCK_PROVIDER=
# Tests only (MEDIA_PROVIDER=mock): force a failure for every picture
# (fail | timeout | rate-limit | blocked | malformed | empty). AI_MOCK_DELAY_MS also applies.
# MEDIA_MOCK_SCENARIO=

# ---------------------------------------------------------------------------
# Billing (Phase 5) — SERVER-ONLY. Never NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# razorpay | mock (tests; refused in production). Unset = online payment unavailable
# (plans, limits and the Free plan still work).
BILLING_PROVIDER=
# Razorpay Dashboard → Account & Settings → API Keys (test keys start with rzp_test_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay plan ids (monthly; the server checks their amount equals billing_plans.price_paise).
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PREMIUM=
# Optional fast pre-check of webhook signatures. The authoritative check uses the same secret
# stored in Supabase Vault as 'razorpay_webhook_secret' (see docs/PHASE_5.md). If set, it MUST
# equal the Vault value; leaving it unset is fine.
RAZORPAY_WEBHOOK_SECRET=
# Tests only (BILLING_PROVIDER=mock); the same value must be in Vault as 'mock_webhook_secret'
# while tests run.
# BILLING_MOCK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Social publishing (Phase 6) — SERVER-ONLY. Never NEXT_PUBLIC_. See docs/PHASE_6.md.
# ---------------------------------------------------------------------------
# Required for any publishing. 64 random hex chars; the SAME value must be stored in Supabase
# Vault as 'publishing_server_secret' (database functions + the pg_cron scheduler use it).
PUBLISHING_SERVER_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored platform tokens
# (AES-256-GCM). Changing it makes stored tokens unreadable: every account must reconnect.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Tests only: mock providers (refused in production; the scheduler endpoint does nothing).
# PUBLISHING_PROVIDER=mock
# Meta app (developers.facebook.com): Facebook Pages + Instagram (Facebook Login for Business)
# and WhatsApp (Embedded Signup). The app id is public by design (Embedded Signup needs it).
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration id for Pages + Instagram publishing.
META_LOGIN_CONFIG_ID=
# Facebook Login for Business configuration id for WhatsApp Embedded Signup (v4).
META_WHATSAPP_CONFIG_ID=
# Any random string; enter the same in App Dashboard › Webhooks (verify token).
META_WEBHOOK_VERIFY_TOKEN=
# Google OAuth web client (YouTube + Google Business Profile).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Never add a Supabase secret/service-role key with a NEXT_PUBLIC_ prefix.
